{{ 'retra-theme.css' | asset_url | stylesheet_tag }}

<section class="retra-section retra-assure">
  <div class="retra-wrap retra-assure__grid">
    {%- for block in section.blocks -%}
      <div class="retra-assure__item retra-reveal" {{ block.shopify_attributes }}>
        <span class="retra-assure__icon">{% render 'retra-icon', icon: block.settings.icon %}</span>
        <div>
          <strong>{{ block.settings.title }}</strong>
          <span>{{ block.settings.subtitle }}</span>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Assurance strip",
  "class": "retra-assure-section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "flask", "label": "Flask" },
            { "value": "microscope", "label": "Microscope" },
            { "value": "globe", "label": "Globe" },
            { "value": "box", "label": "Box" }
          ],
          "default": "flask"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Verified Compounds"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Lab tested & authentic"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Assurance strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "flask", "title": "Verified Compounds", "subtitle": "Lab tested & authentic" } },
        { "type": "item", "settings": { "icon": "microscope", "title": "Research Grade", "subtitle": "For research use only" } },
        { "type": "item", "settings": { "icon": "globe", "title": "Direct Sourcing", "subtitle": "No middlemen" } },
        { "type": "item", "settings": { "icon": "box", "title": "Discreet Packaging", "subtitle": "100% private & secure" } }
      ]
    }
  ]
}
{% endschema %}
