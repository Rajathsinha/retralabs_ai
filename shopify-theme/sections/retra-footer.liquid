{{ 'retra-theme.css' | asset_url | stylesheet_tag }}

<footer class="retra-section retra-footer">
  <div class="retra-wrap">
    <div class="retra-footer__grid">
      <div>
        <a href="{{ routes.root_url }}" class="retra-footer__brand">
          {%- if section.settings.logo -%}
            <img
              src="{{ section.settings.logo | image_url: width: 240 }}"
              width="{{ section.settings.logo.width }}"
              height="{{ section.settings.logo.height }}"
              alt="{{ shop.name | escape }}"
              loading="lazy"
            >
          {%- else -%}
            <span style="color: #5B8DEF; display: inline-flex;">{% render 'retra-icon', icon: 'logo' %}</span>
            {{ shop.name }}
          {%- endif -%}
        </a>
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading | default: block.settings.menu.title }}</h4>
          <ul class="retra-footer__links">
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <div class="retra-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      {%- if section.settings.legal_note != blank -%}
        <span>{{ section.settings.legal_note }}</span>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "retra-footer-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (light version for dark background)"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Brand description",
      "default": "India's most trusted research peptide source. Verified compounds, direct sourcing, fastest delivery."
    },
    {
      "type": "text",
      "id": "legal_note",
      "label": "Legal note",
      "default": "All products are for research use only. Not for human consumption."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Leave blank to use the menu's own title."
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu" },
        { "type": "menu" },
        { "type": "menu" }
      ]
    }
  ]
}
{% endschema %}
