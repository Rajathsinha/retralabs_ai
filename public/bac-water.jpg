<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="waterGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#e0f2fe;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#bae6fd;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="bottleGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#f8fafc;stop-opacity:0.95" />
      <stop offset="100%" style="stop-color:#e2e8f0;stop-opacity:0.95" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="800" height="600" fill="#f1f5f9"/>

  <!-- Main vial/bottle -->
  <g transform="translate(400, 300)">
    <!-- Bottle body -->
    <rect x="-80" y="-150" width="160" height="250" rx="15" fill="url(#bottleGradient)" stroke="#94a3b8" stroke-width="3"/>

    <!-- Water level -->
    <rect x="-75" y="-80" width="150" height="170" rx="12" fill="url(#waterGradient)" opacity="0.7"/>

    <!-- Bottle cap -->
    <rect x="-60" y="-170" width="120" height="25" rx="5" fill="#64748b"/>
    <rect x="-55" y="-180" width="110" height="15" rx="3" fill="#475569"/>

    <!-- Label -->
    <rect x="-70" y="-40" width="140" height="80" rx="5" fill="white" opacity="0.9" stroke="#cbd5e1" stroke-width="2"/>

    <!-- Text on label -->
    <text x="0" y="-10" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#0c4a6e" text-anchor="middle">
      BAC WATER
    </text>
    <text x="0" y="15" font-family="Arial, sans-serif" font-size="14" fill="#0369a1" text-anchor="middle">
      Bacteriostatic
    </text>
    <text x="0" y="35" font-family="Arial, sans-serif" font-size="12" fill="#475569" text-anchor="middle">
      Pharma Grade
    </text>

    <!-- Shine effect -->
    <ellipse cx="-40" cy="-100" rx="20" ry="40" fill="white" opacity="0.4"/>

    <!-- Volume indicator lines -->
    <line x1="-75" y1="-50" x2="-85" y2="-50" stroke="#64748b" stroke-width="2"/>
    <text x="-95" y="-45" font-family="Arial, sans-serif" font-size="10" fill="#64748b">10mL</text>

    <line x1="-75" y1="0" x2="-85" y2="0" stroke="#64748b" stroke-width="2"/>
    <text x="-95" y="5" font-family="Arial, sans-serif" font-size="10" fill="#64748b">5mL</text>

    <line x1="-75" y1="50" x2="-85" y2="50" stroke="#64748b" stroke-width="2"/>
    <text x="-95" y="55" font-family="Arial, sans-serif" font-size="10" fill="#64748b">1mL</text>
  </g>

  <!-- Medical cross symbol in background -->
  <g opacity="0.08">
    <rect x="150" y="100" width="30" height="120" rx="5" fill="#0369a1"/>
    <rect x="105" y="145" width="120" height="30" rx="5" fill="#0369a1"/>
  </g>

  <g opacity="0.08">
    <rect x="620" y="350" width="30" height="120" rx="5" fill="#0369a1"/>
    <rect x="575" y="395" width="120" height="30" rx="5" fill="#0369a1"/>
  </g>

  <!-- Sterile indicator -->
  <g transform="translate(400, 480)">
    <rect x="-80" y="-15" width="160" height="30" rx="15" fill="#06b6d4" opacity="0.2" stroke="#0891b2" stroke-width="2"/>
    <text x="0" y="7" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#0e7490" text-anchor="middle">
      STERILE • 0.9% BENZYL ALCOHOL
    </text>
  </g>
</svg>